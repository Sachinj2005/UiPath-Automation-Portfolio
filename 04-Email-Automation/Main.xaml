<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:si="clr-namespace:System.IO;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Safe Local Email Automation">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="mailText" />
      <Variable x:TypeArguments="x:Boolean" Name="isMatch" />
      <Variable x:TypeArguments="x:String" Name="draftText" />
      <Variable x:TypeArguments="x:String" Name="draftFileName" />
      <Variable x:TypeArguments="x:String" Name="processedFileName" />
      <Variable x:TypeArguments="x:Int32" Name="processedCount" />
      <Variable x:TypeArguments="x:Int32" Name="keywordMatches" />
      <Variable x:TypeArguments="x:Int32" Name="attachmentsSaved" />
      <Variable x:TypeArguments="x:Int32" Name="draftsCreated" />
      <Variable x:TypeArguments="x:String" Name="summary" />
    </Sequence.Variables>
    <ui:CreateDirectory ContinueOnError="False" Output="{x:Null}" Path="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Attachments&quot;)]" DisplayName="Create Attachment Folder" />
    <ui:CreateDirectory ContinueOnError="False" Output="{x:Null}" Path="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Drafts&quot;)]" DisplayName="Create Draft Folder" />
    <ui:CreateDirectory ContinueOnError="False" Output="{x:Null}" Path="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Processed&quot;)]" DisplayName="Create Processed Folder" />
    <ui:ForEachFileX DisplayName="Read Local Unread Messages" Folder="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Input&quot;)]" IncludeSubDirectories="False" OrderBy="NameAscFirst" SkipFolderWithoutPermission="False">
      <ui:ForEachFileX.Body>
        <ActivityAction x:TypeArguments="si:FileInfo, x:Int32">
          <ActivityAction.Argument1>
            <DelegateInArgument x:TypeArguments="si:FileInfo" Name="CurrentFile" />
          </ActivityAction.Argument1>
          <ActivityAction.Argument2>
            <DelegateInArgument x:TypeArguments="x:Int32" Name="CurrentIndex" />
          </ActivityAction.Argument2>
          <Sequence DisplayName="Process Local Message">
            <If Condition="[CurrentFile.Extension.ToLowerInvariant = &quot;.eml&quot;]">
              <If.Then>
                <Sequence DisplayName="Process EML">
                  <ui:ReadTextFile File="{x:Null}" Content="[mailText]" DisplayName="Read EML Message" FileName="[CurrentFile.FullName]" />
                  <ui:InvokeCode Code="Dim normalized = mailText.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf)&#xA;Dim lines = normalized.Split(New String() {vbLf}, StringSplitOptions.None)&#xA;Dim sender As String = &quot;&quot;&#xA;Dim subject As String = &quot;&quot;&#xA;Dim attachmentName As String = &quot;&quot;&#xA;&#xA;For Each line As String In lines&#xA;    If line.StartsWith(&quot;From:&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        sender = line.Substring(5).Trim()&#xA;    ElseIf line.StartsWith(&quot;Subject:&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        subject = line.Substring(8).Trim()&#xA;    ElseIf line.StartsWith(&quot;Attachment:&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        attachmentName = line.Substring(11).Trim()&#xA;    End If&#xA;Next&#xA;&#xA;Dim isTestMail = normalized.IndexOf(&quot;X-Test-Mailbox: true&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0&#xA;Dim isUnread = fileName.StartsWith(&quot;Unread_&quot;, StringComparison.OrdinalIgnoreCase)&#xA;Dim subjectLower = subject.ToLowerInvariant()&#xA;Dim keywordHit = subjectLower.Contains(&quot;invoice&quot;) OrElse subjectLower.Contains(&quot;approval&quot;) OrElse subjectLower.Contains(&quot;student&quot;) OrElse subjectLower.Contains(&quot;report&quot;) OrElse subjectLower.Contains(&quot;request&quot;)&#xA;isMatch = isTestMail AndAlso isUnread AndAlso keywordHit&#xA;draftText = &quot;&quot;&#xA;draftFileName = System.IO.Path.GetFileNameWithoutExtension(fileName) &amp; &quot;_ReplyDraft.txt&quot;&#xA;processedFileName = fileName&#xA;&#xA;If isTestMail AndAlso isUnread Then&#xA;    processedCount += 1&#xA;    If attachmentName &lt;&gt; &quot;&quot; Then&#xA;        Dim attachmentSource = System.IO.Path.Combine(inputDirectory, attachmentName)&#xA;        If System.IO.File.Exists(attachmentSource) Then&#xA;            System.IO.File.Copy(attachmentSource, System.IO.Path.Combine(outputRoot, &quot;Attachments&quot;, System.IO.Path.GetFileName(attachmentName)), True)&#xA;            attachmentsSaved += 1&#xA;        End If&#xA;    End If&#xA;    System.IO.File.Copy(filePath, System.IO.Path.Combine(outputRoot, &quot;Processed&quot;, fileName), True)&#xA;End If&#xA;&#xA;If isMatch Then&#xA;    keywordMatches += 1&#xA;    draftsCreated += 1&#xA;    draftText = &quot;To: &quot; &amp; sender &amp; Environment.NewLine &amp;&#xA;                &quot;Subject: Re: &quot; &amp; subject &amp; Environment.NewLine &amp; Environment.NewLine &amp;&#xA;                &quot;Draft reply only - this message was prepared from safe local test data and was not sent.&quot;&#xA;End If" DisplayName="Classify Message And Prepare Draft">
                    <ui:InvokeCode.Arguments>
                      <InArgument x:TypeArguments="x:String" x:Key="mailText">[mailText]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="fileName">[CurrentFile.Name]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="filePath">[CurrentFile.FullName]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="inputDirectory">[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Input&quot;)]</InArgument>
                      <InArgument x:TypeArguments="x:String" x:Key="outputRoot">[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;)]</InArgument>
                      <OutArgument x:TypeArguments="x:Boolean" x:Key="isMatch">[isMatch]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="draftText">[draftText]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="draftFileName">[draftFileName]</OutArgument>
                      <OutArgument x:TypeArguments="x:String" x:Key="processedFileName">[processedFileName]</OutArgument>
                      <InOutArgument x:TypeArguments="x:Int32" x:Key="processedCount">[processedCount]</InOutArgument>
                      <InOutArgument x:TypeArguments="x:Int32" x:Key="keywordMatches">[keywordMatches]</InOutArgument>
                      <InOutArgument x:TypeArguments="x:Int32" x:Key="attachmentsSaved">[attachmentsSaved]</InOutArgument>
                      <InOutArgument x:TypeArguments="x:Int32" x:Key="draftsCreated">[draftsCreated]</InOutArgument>
                    </ui:InvokeCode.Arguments>
                  </ui:InvokeCode>
                  <If Condition="[isMatch]">
                    <If.Then>
                      <Sequence DisplayName="Write Reply Draft">
                        <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Save Reply Draft" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Drafts&quot;, draftFileName)]" Text="[draftText]" />
                      </Sequence>
                    </If.Then>
                    <If.Else>
                      <Sequence />
                    </If.Else>
                  </If>
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence />
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachFileX.Body>
    </ui:ForEachFileX>
    <Assign DisplayName="Build Local Email Summary">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[summary]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["Processed unread test messages: " &amp; processedCount.ToString() &amp; Environment.NewLine &amp; "Keyword matches: " &amp; keywordMatches.ToString() &amp; Environment.NewLine &amp; "Attachments saved: " &amp; attachmentsSaved.ToString() &amp; Environment.NewLine &amp; "Reply drafts created: " &amp; draftsCreated.ToString() &amp; Environment.NewLine &amp; "Safety: local .eml fixtures only; no messages sent or deleted."]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Write Email Processing Summary" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;EmailSummary.txt&quot;)]" Text="[summary]" />
  </Sequence>
</Activity>

