<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="CSV Data Processing Automation">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputText" />
      <Variable x:TypeArguments="x:String" Name="filteredCsv" />
      <Variable x:TypeArguments="x:String" Name="summary" />
    </Sequence.Variables>
    <ui:ReadTextFile File="{x:Null}" Content="[inputText]" DisplayName="Read Student CSV" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Input&quot;, &quot;Students.csv&quot;)]" />
    <ui:InvokeCode Code="Dim lines = inputText.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).Split(New String() {vbLf}, StringSplitOptions.RemoveEmptyEntries)&#xA;Dim totalRecords As Integer = 0&#xA;Dim validScores As New List(Of Double)&#xA;Dim rows As New List(Of String)&#xA;&#xA;For i As Integer = 1 To lines.Length - 1&#xA;    Dim fields = lines(i).Split(&quot;,&quot;c)&#xA;    If fields.Length &gt;= 3 Then&#xA;        totalRecords += 1&#xA;        Dim score As Double&#xA;        If Double.TryParse(fields(2).Trim(), Globalization.NumberStyles.Float, Globalization.CultureInfo.InvariantCulture, score) Then&#xA;            validScores.Add(score)&#xA;            If score &gt; 75 Then&#xA;                rows.Add(fields(0).Trim() &amp; &quot;,&quot; &amp; fields(1).Trim() &amp; &quot;,&quot; &amp; score.ToString(&quot;0.##&quot;, Globalization.CultureInfo.InvariantCulture))&#xA;            End If&#xA;        End If&#xA;    End If&#xA;Next&#xA;&#xA;rows.Sort(Function(left As String, right As String)&#xA;              Dim leftScore = Double.Parse(left.Substring(left.LastIndexOf(&quot;,&quot;c) + 1), Globalization.CultureInfo.InvariantCulture)&#xA;              Dim rightScore = Double.Parse(right.Substring(right.LastIndexOf(&quot;,&quot;c) + 1), Globalization.CultureInfo.InvariantCulture)&#xA;              Return rightScore.CompareTo(leftScore)&#xA;          End Function)&#xA;&#xA;filteredCsv = &quot;StudentName,Course,Score&quot;&#xA;If rows.Count &gt; 0 Then&#xA;    filteredCsv &amp;= Environment.NewLine &amp; String.Join(Environment.NewLine, rows)&#xA;End If&#xA;&#xA;If validScores.Count &gt; 0 Then&#xA;    Dim totalScore As Double = 0&#xA;    Dim highest As Double = validScores(0)&#xA;    Dim lowest As Double = validScores(0)&#xA;    For Each currentScore As Double In validScores&#xA;        totalScore += currentScore&#xA;        If currentScore &gt; highest Then highest = currentScore&#xA;        If currentScore &lt; lowest Then lowest = currentScore&#xA;    Next&#xA;    summary = &quot;Total records: &quot; &amp; totalRecords.ToString() &amp; Environment.NewLine &amp;&#xA;              &quot;Valid score records: &quot; &amp; validScores.Count.ToString() &amp; Environment.NewLine &amp;&#xA;              &quot;Above 75: &quot; &amp; rows.Count.ToString() &amp; Environment.NewLine &amp;&#xA;              &quot;Average score: &quot; &amp; (totalScore / validScores.Count).ToString(&quot;0.00&quot;, Globalization.CultureInfo.InvariantCulture) &amp; Environment.NewLine &amp;&#xA;              &quot;Highest score: &quot; &amp; highest.ToString(&quot;0.##&quot;, Globalization.CultureInfo.InvariantCulture) &amp; Environment.NewLine &amp;&#xA;              &quot;Lowest score: &quot; &amp; lowest.ToString(&quot;0.##&quot;, Globalization.CultureInfo.InvariantCulture)&#xA;Else&#xA;    summary = &quot;Total records: &quot; &amp; totalRecords.ToString() &amp; Environment.NewLine &amp;&#xA;              &quot;Valid score records: 0&quot; &amp; Environment.NewLine &amp;&#xA;              &quot;Above 75: 0&quot; &amp; Environment.NewLine &amp;&#xA;              &quot;Average score: N/A&quot; &amp; Environment.NewLine &amp;&#xA;              &quot;Highest score: N/A&quot; &amp; Environment.NewLine &amp;&#xA;              &quot;Lowest score: N/A&quot;&#xA;End If" DisplayName="Filter Sort And Calculate Statistics">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="inputText">[inputText]</InArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="filteredCsv">[filteredCsv]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="summary">[summary]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:CreateDirectory ContinueOnError="False" Output="{x:Null}" Path="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;)]" DisplayName="Ensure Output Folder" />
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Write Filtered Students CSV" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;FilteredStudents.csv&quot;)]" Text="[filteredCsv]" />
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Write Statistics Summary" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Summary.txt&quot;)]" Text="[summary]" />
  </Sequence>
</Activity>

