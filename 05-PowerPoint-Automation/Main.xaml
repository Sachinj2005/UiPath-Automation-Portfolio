<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Log Analyzer Automation">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputText" />
      <Variable x:TypeArguments="x:String" Name="errorReport" />
      <Variable x:TypeArguments="x:String" Name="summaryCsv" />
    </Sequence.Variables>
    <ui:ReadTextFile File="{x:Null}" Content="[inputText]" DisplayName="Read Application Log" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Template&quot;, &quot;application.log&quot;)]" />
    <ui:InvokeCode Code="Dim lines = inputText.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).Split(New String() {vbLf}, StringSplitOptions.RemoveEmptyEntries)&#xA;Dim infoCount As Integer = 0&#xA;Dim warningCount As Integer = 0&#xA;Dim errorCount As Integer = 0&#xA;Dim errors As New List(Of String)&#xA;&#xA;For Each line As String In lines&#xA;    Dim tokens = line.Trim().Split(New Char() {&quot; &quot;c}, StringSplitOptions.RemoveEmptyEntries)&#xA;    Dim severity As String = &quot;&quot;&#xA;    For Each token As String In tokens&#xA;        Dim normalizedToken = token.Trim().ToUpperInvariant()&#xA;        If normalizedToken = &quot;INFO&quot; OrElse normalizedToken = &quot;WARNING&quot; OrElse normalizedToken = &quot;ERROR&quot; Then&#xA;            severity = normalizedToken&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;    If severity = &quot;INFO&quot; Then&#xA;        infoCount += 1&#xA;    ElseIf severity = &quot;WARNING&quot; Then&#xA;        warningCount += 1&#xA;    ElseIf severity = &quot;ERROR&quot; Then&#xA;        errorCount += 1&#xA;        errors.Add(line.Trim())&#xA;    End If&#xA;Next&#xA;&#xA;If errors.Count = 0 Then&#xA;    errorReport = &quot;No ERROR entries were found.&quot;&#xA;Else&#xA;    errorReport = String.Join(Environment.NewLine, errors)&#xA;End If&#xA;summaryCsv = &quot;Severity,Count&quot; &amp; Environment.NewLine &amp;&#xA;             &quot;INFO,&quot; &amp; infoCount.ToString() &amp; Environment.NewLine &amp;&#xA;             &quot;WARNING,&quot; &amp; warningCount.ToString() &amp; Environment.NewLine &amp;&#xA;             &quot;ERROR,&quot; &amp; errorCount.ToString()" DisplayName="Analyze Log Entries Dynamically">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="inputText">[inputText]</InArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="errorReport">[errorReport]</OutArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="summaryCsv">[summaryCsv]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:CreateDirectory ContinueOnError="False" Output="{x:Null}" Path="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;)]" DisplayName="Ensure Output Folder" />
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Write Error Report" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;ErrorReport.txt&quot;)]" Text="[errorReport]" />
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Write Severity Summary" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;LogSummary.csv&quot;)]" Text="[summaryCsv]" />
  </Sequence>
</Activity>

