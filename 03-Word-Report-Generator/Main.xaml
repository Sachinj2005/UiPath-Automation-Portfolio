<Activity mc:Ignorable="sap sap2010" x:Class="Main" VisualBasic.Settings="{x:Null}" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="HTML Report Generator">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="inputText" />
      <Variable x:TypeArguments="x:String" Name="html" />
    </Sequence.Variables>
    <ui:ReadTextFile File="{x:Null}" Content="[inputText]" DisplayName="Read Report CSV" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Template&quot;, &quot;Students.csv&quot;)]" />
    <ui:InvokeCode Code="Dim lines = inputText.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf).Split(New String() {vbLf}, StringSplitOptions.RemoveEmptyEntries)&#xA;Dim records As New List(Of String())&#xA;Dim validScores As New List(Of Double)&#xA;&#xA;For i As Integer = 1 To lines.Length - 1&#xA;    Dim fields = lines(i).Split(&quot;,&quot;c)&#xA;    If fields.Length &gt;= 3 Then&#xA;        Dim score As Double&#xA;        If Double.TryParse(fields(2).Trim(), Globalization.NumberStyles.Float, Globalization.CultureInfo.InvariantCulture, score) Then&#xA;            validScores.Add(score)&#xA;            records.Add(New String() {fields(0).Trim(), fields(1).Trim(), score.ToString(&quot;0.##&quot;, Globalization.CultureInfo.InvariantCulture)})&#xA;        End If&#xA;    End If&#xA;Next&#xA;&#xA;records.Sort(Function(left As String(), right As String())&#xA;                 Return Double.Parse(right(2), Globalization.CultureInfo.InvariantCulture).CompareTo(Double.Parse(left(2), Globalization.CultureInfo.InvariantCulture))&#xA;             End Function)&#xA;&#xA;Dim average As Double = 0&#xA;Dim highest As Double = 0&#xA;Dim lowest As Double = 0&#xA;If validScores.Count &gt; 0 Then&#xA;    Dim totalScore As Double = 0&#xA;    highest = validScores(0)&#xA;    lowest = validScores(0)&#xA;    For Each currentScore As Double In validScores&#xA;        totalScore += currentScore&#xA;        If currentScore &gt; highest Then highest = currentScore&#xA;        If currentScore &lt; lowest Then lowest = currentScore&#xA;    Next&#xA;    average = totalScore / validScores.Count&#xA;End If&#xA;&#xA;Dim htmlBuilder As New System.Text.StringBuilder()&#xA;htmlBuilder.AppendLine(&quot;&lt;!doctype html&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;html lang=&quot;&quot;en&quot;&quot;&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;head&gt;&lt;meta charset=&quot;&quot;utf-8&quot;&quot;&gt;&lt;meta name=&quot;&quot;viewport&quot;&quot; content=&quot;&quot;width=device-width, initial-scale=1&quot;&quot;&gt;&lt;title&gt;Student Performance Report&lt;/title&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;style&gt;body{font-family:Segoe UI,Arial,sans-serif;background:#f4f7fb;color:#1f2937;margin:0;padding:32px}main{max-width:960px;margin:auto;background:#fff;border-radius:14px;padding:32px;box-shadow:0 8px 24px rgba(15,23,42,.08)}h1{color:#123b63;margin-top:0}table{border-collapse:collapse;width:100%;margin-top:24px}th{background:#123b63;color:#fff;text-align:left;padding:12px}td{border-bottom:1px solid #e5e7eb;padding:12px}.cards{display:flex;gap:16px;flex-wrap:wrap}.card{background:#eaf2fb;border-left:4px solid #2b6cb0;padding:14px 18px;border-radius:8px;min-width:140px}.label{font-size:12px;color:#475569}.value{font-size:22px;font-weight:600}&lt;/style&gt;&lt;/head&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;body&gt;&lt;main&gt;&lt;h1&gt;Student Performance Report&lt;/h1&gt;&lt;p&gt;Generated dynamically from the supplied CSV input.&lt;/p&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;section class=&quot;&quot;cards&quot;&quot;&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;div class=&quot;&quot;card&quot;&quot;&gt;&lt;div class=&quot;&quot;label&quot;&quot;&gt;Records&lt;/div&gt;&lt;div class=&quot;&quot;value&quot;&quot;&gt;&quot; &amp; records.Count.ToString() &amp; &quot;&lt;/div&gt;&lt;/div&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;div class=&quot;&quot;card&quot;&quot;&gt;&lt;div class=&quot;&quot;label&quot;&quot;&gt;Average score&lt;/div&gt;&lt;div class=&quot;&quot;value&quot;&quot;&gt;&quot; &amp; If(validScores.Count = 0, &quot;N/A&quot;, average.ToString(&quot;0.00&quot;, Globalization.CultureInfo.InvariantCulture)) &amp; &quot;&lt;/div&gt;&lt;/div&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;div class=&quot;&quot;card&quot;&quot;&gt;&lt;div class=&quot;&quot;label&quot;&quot;&gt;Highest score&lt;/div&gt;&lt;div class=&quot;&quot;value&quot;&quot;&gt;&quot; &amp; If(validScores.Count = 0, &quot;N/A&quot;, highest.ToString(&quot;0.##&quot;, Globalization.CultureInfo.InvariantCulture)) &amp; &quot;&lt;/div&gt;&lt;/div&gt;&quot;)&#xA;htmlBuilder.AppendLine(&quot;&lt;/section&gt;&lt;h2&gt;Student details&lt;/h2&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Student&lt;/th&gt;&lt;th&gt;Course&lt;/th&gt;&lt;th&gt;Score&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&quot;)&#xA;For Each record As String() In records&#xA;    htmlBuilder.AppendLine(&quot;&lt;tr&gt;&lt;td&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(record(0)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; System.Net.WebUtility.HtmlEncode(record(1)) &amp; &quot;&lt;/td&gt;&lt;td&gt;&quot; &amp; record(2) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;)&#xA;Next&#xA;htmlBuilder.AppendLine(&quot;&lt;/tbody&gt;&lt;/table&gt;&lt;p&gt;&lt;strong&gt;Lowest score:&lt;/strong&gt; &quot; &amp; If(validScores.Count = 0, &quot;N/A&quot;, lowest.ToString(&quot;0.##&quot;, Globalization.CultureInfo.InvariantCulture)) &amp; &quot;&lt;/p&gt;&lt;/main&gt;&lt;/body&gt;&lt;/html&gt;&quot;)&#xA;html = htmlBuilder.ToString()" DisplayName="Build Dynamic HTML Report">
      <ui:InvokeCode.Arguments>
        <InArgument x:TypeArguments="x:String" x:Key="inputText">[inputText]</InArgument>
        <OutArgument x:TypeArguments="x:String" x:Key="html">[html]</OutArgument>
      </ui:InvokeCode.Arguments>
    </ui:InvokeCode>
    <ui:CreateDirectory ContinueOnError="False" Output="{x:Null}" Path="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;)]" DisplayName="Ensure Output Folder" />
    <ui:WriteTextFile File="{x:Null}" Output="{x:Null}" DisplayName="Write HTML Report" FileName="[System.IO.Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Report.html&quot;)]" Text="[html]" />
  </Sequence>
</Activity>

